{
  "name": "checkbar",
  "productName": "Checkbar",
  "version": "1.3.0",
  "description": "Checkbar — die Menübar-Todo-App für macOS: Aufgaben in Sekunden eintragen, Tag und Woche planen, Unerledigtes wandert automatisch weiter.",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node scripts/test-model.js && electron scripts/test-ui.js",
    "shots": "electron scripts/screenshot.js",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.cesa.checkbar",
    "productName": "Checkbar",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
